# --- Telegram ---------------------------------------------------------------
# From @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID. Leave empty on first run, message the bot,
# and it will reply with your ID. Only this user can use the bot.
ALLOWED_USER_ID=

# --- Google Sheet -----------------------------------------------------------
# The long ID in the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
SPREADSHEET_ID=1U5oTuWtv29_U81h-UF1bghu9l_S4gkofaYGZ6SHFFRQ
# Service-account key file (share the sheet with its client_email as Editor)
GOOGLE_CREDENTIALS_FILE=service_account.json

# --- AI (free tiers) ----------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Tried in order; the next one is used when a model is rate-limited or down.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.1-flash-lite
# Optional backup when all Gemini models are exhausted: https://console.groq.com/keys
GROQ_API_KEY=
# Free plan: ~8K tokens/minute, 1,000 requests/day per model
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Backup path only: PDFs/photos are OCR'd locally with Tesseract (apt install tesseract-ocr).
# Max characters of document text sent to the backup AI, and max PDF pages to OCR.
FALLBACK_DOC_CHARS=9000
OCR_MAX_PAGES=20

# --- Behaviour ----------------------------------------------------------------
TIMEZONE=America/New_York
# Messages that arrive within this many seconds are analyzed together
# (photo albums, "text + photo", several forwards at once).
BATCH_WINDOW_SECONDS=4
LOG_LEVEL=INFO
